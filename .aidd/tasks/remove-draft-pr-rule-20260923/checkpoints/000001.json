    "task_sha256": "f9ecfe64ca0817f320bde9ac59f1e8cdaf3d56d73a8e2447414b609dcf3d948a",
    "reason": "入力findingは、ユーザーが明示した『PRをDraft状態で作成するようにしているルールを消してほしい』。原因はGit Workflow正本がDraftを既定とし、Ready for Reviewを明示時だけに制限していること。現状維持は依頼に反し、例外追加は不要な分岐を残すため不採用とし、所有元の1規定を直接削除する。規定の残存は検索で決定論的に検出できるが、将来の各PR状態は依頼と文脈に基づく意味判断なので新しい機械検査は追加しない。担当agentがPR以外のdraft概念を除外し、残るPull Request規定と差分をレビューする。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "PRをDraft状態で作成することを基本とする規定を削除する",
        "origin": "intent",
        "evidence": "PRをDraft状態で作成するようにしているルールを消してほしい"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "Git WorkflowがPR作成時のDraft状態を既定として要求せず、Ready for Reviewをユーザー明示時だけに制限しない",
          "requirement_id": "FR-1"
        }
