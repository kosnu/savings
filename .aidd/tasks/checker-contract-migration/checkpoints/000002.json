    "reason": "検証前にmanual caseをローカルreviewとGitHub承認設定のread-backへ具体化。PRの実CI確認はcommit後のShip受入確認として実行する。設計・ownership・成功条件は維持。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "古いcheckerとの非互換変更を安全に移行できるCI経路を実装する",
        "origin": "intent",
        "evidence": "checkerの契約変更でも今後使える移行経路を作る。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "通常PRはbase checker、明示されたAIDD契約移行だけはbase所有scope検査・候補検証・コミットに結び付いたGitHubの人による承認が揃う場合に成功する",
          "requirement_id": "FR-1"
        }
      ],
      "verification_cases": [
