  "decision": {
    "schema_version": 6,
    "kind": "decision",
    "task_sha256": "a993db39cff224322b9a2294f4dab9dbe507a18bc8704548d41ed66868b98c6f",
    "reason": "Google OAuthのBurnetoブランドと新OAuthクライアント、SupabaseのGoogle providerとcallback、Cloudflare Pagesの既存プロジェクトを確認した。Googleログイン方式、Supabase Project ID、公開カスタムドメインを維持し、Cloudflare Pagesは既存プロジェクトをburnetoへ改名してデプロイ履歴とhostnameを継続利用する。Supabaseは管理画面表示名だけBurnetoへ変更する。リポジトリでは改名後のWrangler CLI対象だけをburnetoへ同期し、本番デプロイは#1778へ残す。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "Google OAuth同意画面の名称とロゴをBurnetoへ変更する",
        "origin": "intent",
        "evidence": "- [ ] Google OAuth同意画面の名称とロゴがBurnetoへ変更されている"
      },
      {
        "id": "FR-2",
        "text": "Cloudflare Pagesの表示名またはプロジェクト名の扱いを決め、必要な変更を反映する",
        "origin": "intent",
        "evidence": "- [ ] Cloudflare Pagesの表示名またはプロジェクト名の扱いが決まり、必要な変更が反映されている"
      },
      {
        "id": "FR-3",
        "text": "Supabaseなど利用者から見えるサービス名やURLを確認する",
        "origin": "intent",
        "evidence": "- [ ] Supabaseなど、利用者から見えるサービス名やURLが確認されている"
      },
      {
        "id": "FR-4",
        "text": "認証後のリダイレクトが正常に動作する",
        "origin": "intent",
        "evidence": "- [ ] 認証後のリダイレクトが正常に動作する"
      },
      {
        "id": "NFR-1",
        "text": "既存のGoogleログイン機能と利用者ごとのデータ分離を変更しない",
        "origin": "intent",
        "evidence": "- 既存のGoogleログイン機能と利用者ごとのデータ分離を変更しない"
      },
      {
        "id": "NFR-2",
        "text": "本番反映はリブランド変更を揃えるIssue #1778へ残し、このTaskでは実行しない",
        "origin": "derived",
        "evidence": "Milestone内のIssue #1778が各リブランド変更を検証して本番環境へ反映する責務を持つため"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "Google Auth PlatformがBurneto名称とBurnetoロゴを表示し、Supabase用OAuthクライアントを維持する",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "既存Cloudflare Pagesプロジェクトをburneto名で継続利用し、デプロイワークフローも同じ名前を参照する",
          "requirement_id": "FR-2"
        },
        {
          "id": "PB-3",
          "type": "state_transition",
          "description": "Supabaseの管理画面表示名をBurnetoとし、Project ID、Supabase URL、Google callback URL、サイトURLを維持する",
          "requirement_id": "FR-3"
        },
        {
          "id": "PB-4",
          "type": "state_transition",
          "description": "Google OAuth callback後に既存の認証routeを経由して支払い画面へ遷移する",
          "requirement_id": "FR-4"
        },
        {
          "id": "PB-5",
          "type": "state_transition",
          "description": "Googleログイン方式、Supabase Project ID、利用者データの分離境界を変更しない",
          "requirement_id": "NFR-1"
        },
        {
          "id": "PB-6",
          "type": "state_transition",
          "description": "このTaskでは本番デプロイを実行しない",
          "requirement_id": "NFR-2"
        }
      ],
      "verification_cases": [
