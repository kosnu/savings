    "task_sha256": "a94a1c7a1658a01d56992bf0a1128c294908d05ea4eefb3afbdaaa04f67baa8a",
    "reason": "通常の明示Ship依頼が固定delivery値で拒否される。切替機能の追加では区分が残るため、区分判定を撤去し旧fieldは読取互換性のみ保持する。旧binary identityの移行は別の信頼条件であり緩和しない。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "delivery区分を撤去し整合性と既存記録の互換性を検証する",
        "origin": "intent",
        "evidence": "AIDDのdelivery=local / delivery=prという配信区分と、それを根拠にコミット・PR作成を妨げる制約を撤去する。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "新規Taskが配信区分を要求せず、旧記録の配信値もShipとCIとfinishを分岐させない。他の安全条件は維持する。",
          "requirement_id": "FR-1"
        }
      ],
