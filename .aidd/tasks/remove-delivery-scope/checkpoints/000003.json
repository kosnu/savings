  "decision": {
    "schema_version": 5,
    "kind": "decision",
    "task_sha256": "a94a1c7a1658a01d56992bf0a1128c294908d05ea4eefb3afbdaaa04f67baa8a",
    "reason": "未解決レビューから独立Learnで確定した証跡要件を、同じPRの元Taskへ反映する。CI契約移行のみでは開始時checkerの現在証跡、実行checker移行では移行記録と移行先checkerの新証跡を要求することを文書と回帰テストで固定する。ユーザーのship依頼に基づき今回の全体を再検証して追加配信する。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "delivery区分を撤去し整合性と既存記録の互換性を検証する",
        "origin": "intent",
        "evidence": "AIDDのdelivery=local / delivery=prという配信区分と、それを根拠にコミット・PR作成を妨げる制約を撤去する。"
      },
      {
        "id": "FR-2",
        "text": "旧Taskの開始記録を保持した明示的なchecker移行とmain統合記録で、配信する最終状態全体を再検証し、base側の契約移行検査と人の承認を経て同じPRを受け入れ可能にする。",
        "origin": "derived",
        "evidence": "最新の追加依頼「通せるようにもしろよ」。配信区分撤去の既存Taskを同じPRで継続するための必要な契約移行。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "新規Taskが配信区分を要求せず、旧記録の配信値もShipとCIとfinishを分岐させない。他の安全条件は維持する。",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "明示された旧checker・checkpoint・証跡と新binaryを結合し、統合baseから最終状態の権限と全体証跡を検査する。移行Taskは通常CIでは拒否し、移行専用の候補検証とbase検査・人の承認を要求する。",
          "requirement_id": "FR-2"
        }
      ],
