  "decision": {
    "schema_version": 6,
    "kind": "decision",
    "task_sha256": "e7335458f2463e2668703ebe720a25208adf24ccccfe1fe5976b7bf0ad4502dd",
    "reason": "Issue #1787はネイティブアプリ完成までの暫定利用としてAndroid Chromeからのインストールとstandalone起動を求め、Service Worker・オフライン対応・キャッシュ制御を明示的に対象外としている。既存manifestはname、start_url、scope、必要サイズのアイコンを備えており、display=browserだけが要求と一致しないため、displayをstandaloneへ変更する最小差分を採用する。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "Android ChromeでBurnetoをホーム画面へインストールでき、ホーム画面のアイコンからstandalone表示で起動できる",
        "origin": "intent",
        "evidence": "- [ ] Android ChromeでBurnetoをホーム画面へインストールできる\n- [ ] ホーム画面のアイコンから起動すると、ブラウザのアドレスバーを表示しないstandalone表示になる"
      },
      {
        "id": "NFR-1",
        "text": "Service Worker、オフライン対応、キャッシュ制御、プッシュ通知を追加しない",
        "origin": "intent",
        "evidence": "### 対象外\n\n- Service Worker\n- オフライン対応\n- キャッシュ制御\n- プッシュ通知"
      },
      {
        "id": "NFR-2",
        "text": "既存のWebアプリの機能とデータ通信を変更しない",
        "origin": "intent",
        "evidence": "- 既存のWebアプリの機能とデータ通信は変更しない"
      },
      {
        "id": "NFR-3",
        "text": "通常のブラウザアクセスでは既存機能を引き続き利用できる",
        "origin": "intent",
        "evidence": "- [ ] 通常のブラウザアクセスでは既存機能を引き続き利用できる"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "BurnetoのWeb App Manifestがstandalone表示を要求し、ホーム画面からの起動時にブラウザUIを表示しない",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "Service Workerやオフライン用資産を追加せず、ネットワーク接続を前提としたまま動作する",
          "requirement_id": "NFR-1"
        },
        {
          "id": "PB-3",
          "type": "state_transition",
          "description": "manifestのdisplay以外の既存項目とWebアプリの機能・データ通信を変更しない",
          "requirement_id": "NFR-2"
        },
        {
          "id": "PB-4",
          "type": "state_transition",
          "description": "通常のブラウザアクセス時は既存Web機能を引き続き利用できる",
          "requirement_id": "NFR-3"
        }
      ],
