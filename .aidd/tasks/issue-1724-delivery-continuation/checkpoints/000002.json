    "task_sha256": "9c94e86e4838bb2a301f1261b9eebeacb86c8118d194f8e3dc8f102ba8fe8e49",
    "reason": "入力元はユーザーが対応を依頼したIssue #1724の運用finding。通常の追加Ship依頼で発生し、既存のbaseline固定規則の適用不全としてLearn対象とする。PR #1723のTask learn-pnpm12-lockfile-ship（head 1165457c62002d8dcdb6ed67b0c1f3d4234279a9）のauthorizationはship依頼にagentの独立PR判断を加えている。現行workflowはbaseline固定を要求する一方、意図・権限変更で別task、review policyは完了済みtaskなら新Developmentと記載し、追加配信との境界が曖昧。Startはcleanと同名Taskの非存在を、CheckDeliveryは指定PR内のTaskとmerge-baseを検査するが、別branchへ移した成果物と人間の許可の意味は判定できない。対策を比較: 新たな横断Task台帳やdelivery変更CLIは契約・互換性の拡張を要し、このfindingに対する最小対策ではない。既存CI緩和は不変条件に反する。主分類は既存ルールのsharp化とし、配信判断を所有するworkflowを正本に、operations・Codex adapter・review policyの継続経路を同期する。元Taskを保持し、未対応delivery変更は停止し具体的な契約変更を確認する。新Taskを作れば成功するという代替経路は示さない。機械検査が人間の許可を証明できない限界は維持する。 検証前に未実施のPR配信read-backを観測対象に含めないよう、VC-2を検証時点の確認に限定し、read-backはShipのDoneへ残す。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "Taskと基準点の固定を維持して正当な追加配信を扱う",
        "origin": "intent",
        "evidence": "1 PR＝1 Taskと基準点固定を守り、配信のためのTask再作成で制約を回避しない。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "追加Ship依頼を既存Taskの継続として処理し、契約変更が必要なら元記録と失敗を保持して停止する",
          "requirement_id": "FR-1"
        }
