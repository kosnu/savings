  "decision": {
    "schema_version": 5,
    "kind": "decision",
    "task_sha256": "b9e4aa01080c03914d9e131503c049e61ef5ad561d06a3622e856f7b5fb1a06e",
    "reason": "PR #1720の未解決レビュー2件が指摘した、候補テストが書ける共有キャッシュをbase checker取得でも信頼してしまう原因を修正する。従来のbase直接buildを採用し、checker cacheはCI base検証で使用しない。Go build/module cacheも新規trusted_dir配下へ分離し、GOENV/GOWORK/GOFLAGS/GOTOOLCHAINを固定する。専用checker cache分離案より直接buildは経路が短く、通常Task間の再利用は維持できる。回帰は候補側で用意されたcacheとbase側のbuild出力を区別し、実workflowがbase sourceを直接buildして得たcheckerだけを実行することを検証する。既存信頼境界の意味を変えず、ソースと実行物の取得経路の両方へ具体化して文書同期する。gofmt指摘は実コマンドで違反なしと確認し、当該ファイル変更は行わない。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "同一ソース・契約・実行環境ではcheckerを再利用し変更時のみbuildする。",
        "origin": "intent",
        "evidence": "checkerの初回準備時と、ビルド元・連動する契約の変更時にビルドし、それ以外のTaskでは対応するbinaryを再利用する。"
      },
      {
        "id": "FR-2",
        "text": "破損・置換を実行前に拒否し固定した契約選択とTask binaryを維持する。",
        "origin": "intent",
        "evidence": "保存済みbinaryのhash不一致は検出して停止し、そのbinaryや任意の手元binaryを実行しない。"
      },
      {
        "id": "FR-3",
        "text": "LearnとCIの信頼境界、既存checker契約検査と文書・実行経路の整合を維持する。",
        "origin": "intent",
        "evidence": "Learnは開始時checkerと旧契約で検証する。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "同一ソース・契約・実行環境ではcheckerを再利用し変更時のみbuildする。",
          "requirement_id": "FR-1"
        },
