    "task_sha256": "f5223d8072f38ceab60f7acbae0afe3f8353b57005810f930337c861cdd79af3",
    "reason": "ユーザーが元画像の取り違えを訂正し、codex-clipboard-186f416c-0e24-41d9-905b-ad3b7aba5006.pngを正しい入力として提供した（SHA-256 cfe1b408e6fdd71e8cef428f701d40a93a77ab89343568fe8dd4b8dea8e6effb）。同じTask/baseline/PR #1779でbrand/logo.pngと簡略版master、それに由来する全favicon/app iconを差し替える。新画像の冷たいラベンダー紫、炎と斜めの紙幣を維持し、離れた火の粉と細部を整理する。既存HTML/manifestの形式・サイズ・余白方針は維持し、全差分を再検証する。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "訂正後の提供ロゴから視認性の高いfavicon/app iconを作成し、既存Webで利用可能にする。",
        "origin": "intent",
        "evidence": "faviconとアプリアイコンが作成されている"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "ブラウザタブとホーム画面で紫の炎と紙幣のBurnetoアイコンが表示され、用途別画像をheadとmanifestから解決できる。",
          "requirement_id": "FR-1"
        }
      ],
