    "reason": "PR #1721の2件に対応。aidd-cycleは条件と要件を分文。harness-taskは費用対効果条件をsubagentへの委譲に限定し人間レビューへの適用拡張を訂正する。ユーザーの次から除外という指定は今回には適用しない。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "サブエージェントの自動利用を促す指示を除去する",
        "origin": "intent",
        "evidence": "不用意に呼ぶようにしているのを無くせ"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "軽微な実装と定型確認はメインで完結し、複雑な独立作業と重大リスクの検証は追加コストに見合う場合に委譲する",
          "requirement_id": "FR-1"
        }
      ],
      "verification_cases": [
        {
          "id": "VC-1",
          "type": "automated",
          "requirement_id": "FR-1",
          "product_behavior_ids": [
