    "requirements": [
      {
        "id": "FR-1",
        "text": "AIDDの概念・工程・1サイクルとTask/Goal/Coreの関係を一貫して定義する",
        "origin": "intent",
        "evidence": "AIDDプロトコル全体の用語・概念・工程の定義と相互関係を明確にし、プロトコルを理解・適用するときに矛盾や解釈の迷いが生じない状態を目指す。"
      },
      {
        "id": "FR-2",
        "text": "1 Task=1サイクルはIntentから開始し、対象指摘がある場合だけ同Task内でLearnを行い、次のIntentは次Taskを開始する",
        "origin": "intent",
        "evidence": "Taskは1サイクルの実行記録であり、指摘がなければLearnは行わない。",
        "intent_revision": 2
      },
      {
        "id": "FR-3",
        "text": "独立したLearn Taskを新規作成できず、既存記録は履歴として読める",
        "origin": "intent",
        "evidence": "独立したLearn Taskは作らない。",
        "intent_revision": 2
      }
    ],
