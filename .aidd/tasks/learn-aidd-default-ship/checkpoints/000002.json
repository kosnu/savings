    "reason": "PR #1717の未解決4コメントに対するLearnの2点を反映する明示許可に基づく改訂。既定prと明示制限という当初intentは維持し、adapterのShip手順と完了条件の無条件化を修正する。Task/GoalのPR提出表現を正本のPR作成または更新へ同期する。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "AIDD Developmentの既定の完了地点をコミット・push・PR提出までに統一する",
        "origin": "intent",
        "evidence": "aidd development で絶対にshipするようにしてほしい。localだかなんだかが指定されてコミットせずに止まるのをなくす。こちらが明示的にshipするなと言った場合のみそうして。そのための追加設定はいらない。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "Development実行依頼から既定でPR提出まで継続し、明示制限だけを既存constraintsに保持する",
          "requirement_id": "FR-1"
        }
