    "task_sha256": "175460468cc43a65bab067c9e3c2f195808eac9b0fbf7ff95374f9036b3d8e0c",
    "reason": "開始時ルール固定による AIDD_VNEXT_GUARDRAIL_DRIFT の実例に基づく追加修正。取り込んだルール文書・rule-mapのcommitと対象を新checkpointで採用し、既存Taskの開始記録を保持して新ルールで全再検証する。旧Development checkerの明示移行も対応する。機械policy/profileの変更は従来の契約で扱う。",
    "requirements": [
      {
        "id": "REQ-1",
        "text": "ユーザーの明示指示がない限りブランチを分けない",
        "origin": "intent",
        "evidence": "ブランチはこちらの指示がない限りわけるな"
      },
      {
        "id": "REQ-2",
        "text": "取り込んだルール変更を既存Development Taskへ採用して全再検証・続行できる",
        "origin": "derived",
        "evidence": "ユーザーが後続で design-rules.md の GUARDRAIL_DRIFT 停止事例を提示し、変更後ルールを既存Taskへ適用する後者を明示許可した。"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "保守変更やTaskの区分ではブランチを自動分割せず、ユーザーの明示指示に従う",
          "requirement_id": "REQ-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "ルールの明示採用で新checkpointを生成し、旧証拠を失効させ、Taskを再作成せず新ルールで続行する",
          "requirement_id": "REQ-2"
        }
      ],
