  "decision": {
    "schema_version": 6,
    "kind": "decision",
    "task_sha256": "5b6358d4b4f8f8d2664002516e30bab7e343e97e3fe61b299a47d89f35b9ab70",
    "reason": "ユーザーが本番ドメインを burneto.com へ変更し、Cloudflare custom domain、DNS、SSL、Supabase Auth、GitHub Environment、Google OAuthの外部設定を完了したと確認した。リポジトリでは現行インフラ文書の旧ドメイン記述だけを新しい本番構成へ同期し、アプリコードと外部設定は変更しない。",
    "requirements": [
      {
        "id": "FR-1",
        "text": "Google OAuthの本番Web originを https://burneto.com として記録する",
        "origin": "derived",
        "evidence": "ユーザーが本番ドメインを burneto.com へ変更し、Google OAuth設定も完了したと確認したため"
      },
      {
        "id": "FR-2",
        "text": "Cloudflare Pagesの本番custom domainを burneto.com として記録する",
        "origin": "derived",
        "evidence": "ユーザーが burneto.com のcustom domain追加、DNS、SSL確認を完了したと確認したため"
      },
      {
        "id": "FR-3",
        "text": "Supabase AuthのSite URLとredirect allow listを burneto.com の現行設定として記録する",
        "origin": "derived",
        "evidence": "ユーザーがSupabase AuthとGitHub Environmentのドメイン設定を手動変更済みと確認したため"
      },
      {
        "id": "NFR-1",
        "text": "Supabase Project ID、Google callback URL、認証provider、既存利用者データを変更しない",
        "origin": "intent",
        "evidence": "- 既存利用者のデータを維持する"
      }
    ],
    "target_state": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "インフラ文書がGoogle OAuthの本番Web originを https://burneto.com と示す",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "インフラ文書がCloudflare Pagesの本番custom domainを burneto.com と示す",
          "requirement_id": "FR-2"
        },
        {
          "id": "PB-3",
          "type": "state_transition",
          "description": "インフラ文書がSupabase AuthのSite URLとredirect allow listを burneto.com と示す",
          "requirement_id": "FR-3"
        },
        {
          "id": "PB-4",
          "type": "state_transition",
          "description": "インフラ文書がSupabase Project ID、Google callback URL、認証provider、利用者データの維持を示す",
          "requirement_id": "NFR-1"
        }
