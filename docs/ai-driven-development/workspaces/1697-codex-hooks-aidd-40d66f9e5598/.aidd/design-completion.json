      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "AIDD制御面の差分がある停止時だけ必要な整合性検証が実行される",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "同一差分の成功検証は再実行されず再入済み失敗は追加継続されない",
          "requirement_id": "FR-2"
        },
        {
          "id": "PB-3",
          "type": "state_transition",
          "description": "compact直後のmodel requestへ5つのAIDD工程不変条件が追加される",
          "requirement_id": "FR-3"
        },
        {
          "id": "PB-4",
          "type": "state_transition",
          "description": "Hookは既存checker gateを補助しGoalまたはphase状態を所有しない",
          "requirement_id": "NFR-1"
        },
        {
          "id": "PB-5",
          "type": "state_transition",
          "description": "compact contextは工程不変条件だけを含みIssue本文と成果物を含まない",
          "requirement_id": "NFR-2"
        },
        {
          "id": "PB-6",
          "type": "state_transition",
