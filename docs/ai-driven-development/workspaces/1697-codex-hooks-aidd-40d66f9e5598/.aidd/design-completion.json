          "requirement_id": "NFR-3"
        },
        {
          "id": "PB-7",
          "type": "state_transition",
          "description": "Hook runnerと回帰testは既存Go module内で新規外部依存なく動作する",
          "requirement_id": "NFR-4"
        },
        {
          "id": "PB-8",
          "type": "state_transition",
