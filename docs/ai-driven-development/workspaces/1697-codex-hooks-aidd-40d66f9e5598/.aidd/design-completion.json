    "value": {
      "product_behaviors": [
        {
          "id": "PB-1",
          "type": "state_transition",
          "description": "AIDD制御面の差分がある停止時だけ必要な整合性検証が実行される",
          "requirement_id": "FR-1"
        },
        {
          "id": "PB-2",
          "type": "state_transition",
          "description": "同一差分の成功検証は再実行されず再入済み失敗は追加継続されない",
          "requirement_id": "FR-2"
        },
        {
          "id": "PB-3",
          "type": "state_transition",
          "description": "compact直後のmodel requestへ5つのAIDD工程不変条件が追加される",
          "requirement_id": "FR-3"
        },
        {
          "id": "PB-4",
          "type": "state_transition",
          "description": "Hookは既存checker gateを補助しGoalまたはphase状態を所有しない",
          "requirement_id": "NFR-1"
        },
        {
          "id": "PB-5",
          "type": "state_transition",
          "description": "compact contextは工程不変条件だけを含みIssue本文と成果物を含まない",
          "requirement_id": "NFR-2"
        },
        {
          "id": "PB-6",
          "type": "state_transition",
          "description": "repo-local Hooksが無効または未信頼でも既存AIDD workflowは独立して動作する",
          "requirement_id": "NFR-3"
        },
        {
          "id": "PB-7",
          "type": "state_transition",
          "description": "Hook runnerと回帰testは既存Go module内で新規外部依存なく動作する",
          "requirement_id": "NFR-4"
        },
        {
          "id": "PB-8",
          "type": "state_transition",
          "description": "Stop判定が対象外と成功とcache skipと理由付き失敗継続へ分類される",
          "requirement_id": "AC-1"
        },
        {
          "id": "PB-9",
          "type": "state_transition",
          "description": "Hook出力は既存workflowまたはcheckerの判定と成果物を上書きしない",
          "requirement_id": "AC-2"
        },
        {
          "id": "PB-10",
          "type": "state_transition",
          "description": "Hooksを無効化した実行でも既存AIDD入口とphase gateが維持される",
          "requirement_id": "AC-3"
        },
        {
          "id": "PB-11",
          "type": "state_transition",
          "description": "Hookの全発火分岐と再入とcompact contextがGo回帰testで固定される",
          "requirement_id": "AC-4"
        },
        {
          "id": "PB-12",
          "type": "state_transition",
          "description": "成功cacheはsessionとcanonical worktreeとGit HEADとGo toolchainと非ignore worktree状態が全て一致する場合だけ再利用される",
          "requirement_id": "NFR-5"
        },
        {
          "id": "PB-13",
          "type": "state_transition",
          "description": "同一制御面差分でもcache identityの任意要素が変わるか取得不能なら整合性検証が再実行される",
          "requirement_id": "AC-5"
        },
        {
          "id": "PB-14",
          "type": "state_transition",
          "description": "canonical rule-mapへ追加されたAIDD制御面pathがHook固有一覧の同期なしでStop検証対象になる",
          "requirement_id": "FR-4"
        }
      ],
