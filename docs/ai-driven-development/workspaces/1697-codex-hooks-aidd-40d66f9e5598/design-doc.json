    "sections": [
      {
        "id": "architecture",
        "heading": "Architecture",
        "blocks": [
          {
            "id": "architecture-baseline",
            "type": "evidence",
            "role": "baseline",
            "owner_id": "architecture",
            "text": "既存Architectureをcache identity要件を含む全Requirementsの完成状態へ更新する。"
          },
          {
            "id": "architecture-body",
            "type": "markdown",
            "markdown": "repo-local hooks.jsonから既存checker Go module内のhook runnerを起動する。runnerはCodexのJSON stdinとGit差分だけを読み、Stopでは対象差分fingerprintに対する既存gate実行結果を派生cacheし、SessionStart compactでは固定された工程不変条件だけを返す。"
          },
          {
            "id": "fr-1-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "FR-1",
            "text": "Git HEADとの差分と非ignore untracked pathからAIDD制御面だけを選別し、該当時だけ既存checker test・phase contract・全成果物・diff整合性を検証する。",
            "product_behavior_ids": [
              "PB-1"
            ]
          },
          {
            "id": "fr-1-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "FR-1",
            "text": "対象差分と対象外差分でvalidation runnerの呼出有無が分かれることをGo testで確認する。"
          },
          {
            "id": "fr-2-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "FR-2",
            "text": "成功済みfingerprintは再生成可能cacheでskipし、失敗時はstop_hook_activeがfalseの一度だけ継続要求を返す。",
            "product_behavior_ids": [
              "PB-2"
            ]
          },
          {
            "id": "fr-2-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "FR-2",
            "text": "同一fingerprintの成功skipとstop_hook_active=true時の非blockをGo testで確認する。"
          },
          {
            "id": "fr-3-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "FR-3",
            "text": "SessionStart source=compactだけに、現在Goal・親Goal所有・上流read-only・BuildからShip・Learn非自動の固定contextを返す。",
            "product_behavior_ids": [
              "PB-3"
            ]
          },
          {
            "id": "fr-3-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "FR-3",
            "text": "compactとそれ以外のsource、および追加context全文をGo testで確認する。"
          },
          {
            "id": "nfr-1-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "NFR-1",
            "text": "Hookは既存checker commandを固定argvで実行する補助層とし、cacheにはphaseやGoal状態を保存しない。",
            "product_behavior_ids": [
              "PB-4"
            ]
          },
          {
            "id": "nfr-1-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "NFR-1",
            "text": "cache schemaとvalidation command一覧に第二の工程状態がないことをコードレビューで確認する。"
          },
          {
            "id": "nfr-2-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "NFR-2",
            "text": "compact contextは5つの工程不変条件を定数として所有し、Issue本文・成果物・transcriptを読まない。",
            "product_behavior_ids": [
              "PB-5"
            ]
          },
          {
            "id": "nfr-2-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "NFR-2",
            "text": "追加contextが必要な5条件だけを含みIssueまたは成果物内容を含まないことをGo testで固定する。"
          },
          {
            "id": "nfr-3-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "NFR-3",
            "text": "Hooks設定はrepo-localの任意補助設定として追加し、既存AIDD入口とgateからHookへの依存を追加しない。",
            "product_behavior_ids": [
              "PB-6"
            ]
          },
          {
            "id": "nfr-3-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "NFR-3",
            "text": "hooks.jsonを無効または不在としても既存checker bootstrapとphase contractが成立する設計を確認する。"
          },
          {
            "id": "nfr-4-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "NFR-4",
            "text": "hook runnerは既存checker Go moduleと標準ライブラリだけを使い、新しいmodule依存を追加しない。",
            "product_behavior_ids": [
              "PB-7"
            ]
          },
          {
            "id": "nfr-4-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "NFR-4",
            "text": "go.modとgo.sumが不変であることを差分レビューで確認する。"
          },
          {
            "id": "ac-1-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "AC-1",
            "text": "Stop出力を対象外、成功、成功cache、失敗継続の決定結果へ正規化し、失敗理由にvalidation名を含める。",
            "product_behavior_ids": [
              "PB-8"
            ]
          },
          {
            "id": "ac-1-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "AC-1",
            "text": "各決定結果とvalidation呼出回数をtable-driven Go testで確認する。"
          },
          {
            "id": "ac-2-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "AC-2",
            "text": "Hook出力はCodexの継続または追加contextだけを指示し、checker成果物や判定値を生成・変更しない。",
            "product_behavior_ids": [
              "PB-9"
            ]
          },
          {
            "id": "ac-2-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "AC-2",
            "text": "Hookの書込先がrepository外cacheだけでcanonical gate出力を所有しないことをコードレビューで確認する。"
          },
          {
            "id": "ac-3-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "AC-3",
            "text": "既存AIDD commandとphase agentはhooks.jsonを参照せず、無効化時も同一の入口検証を実行する。",
            "product_behavior_ids": [
              "PB-10"
            ]
          },
          {
            "id": "ac-3-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "AC-3",
            "text": "Hook無効時の既存workflow非依存性を設定と呼出graphのレビューで確認する。"
          },
          {
            "id": "ac-4-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "AC-4",
            "text": "Go testは発火対象・対象外、成功・失敗、cache skip、再入防止、compact contextと設定shapeを網羅する。",
            "product_behavior_ids": [
              "PB-11"
            ]
          },
          {
            "id": "ac-4-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "AC-4",
            "text": "aidd-checker-tests profileで既存checker回帰を含む全Go testを成功させる。"
          },
          {
            "id": "nfr-5-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "NFR-5",
            "text": "成功cache keyをCodex session、canonical worktree、Git HEAD、Go toolchain、非ignore worktree状態の完全なidentityとして構成し、取得不能なfieldがあればcacheを再利用しない。",
            "product_behavior_ids": [
              "PB-12"
            ]
          },
          {
            "id": "nfr-5-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "NFR-5",
            "text": "各identity fieldの変更と取得不能時に成功cacheを再利用しないことをGo testで確認する。"
          },
          {
            "id": "ac-5-design",
            "type": "evidence",
            "role": "design",
            "owner_id": "AC-5",
            "text": "制御面差分が同じでもsession、worktree、HEAD、toolchain、非ignore worktree状態のいずれかが変化すれば検証を再実行し、全identityが一致する場合だけskipする。",
            "product_behavior_ids": [
              "PB-13"
            ]
          },
          {
            "id": "ac-5-verification",
            "type": "evidence",
            "role": "verification",
            "owner_id": "AC-5",
            "text": "identity各要素を一つずつ変更するtable-driven Go testと完全一致時のskip testで再検証境界を固定する。"
          }
        ]
      }
    ],
